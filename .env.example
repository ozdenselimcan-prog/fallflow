# ─────────────────────────────────────────────────────────────
# FallFlow – Umgebungsvariablen
# Alles außer den Supabase-Variablen ist optional: Fehlende Werte lassen die App
# nie abstürzen, die jeweilige Funktion läuft dann im Demo-/Mock-Modus bzw. wird als
# „Nicht verbunden“ angezeigt.
# ─────────────────────────────────────────────────────────────

# Öffentliche Basis-URL der App (OAuth-Redirects, Upload-Links). Produktion: https://deine-domain.de
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────
# Ohne URL + ANON_KEY startet die App im Demo-Modus mit In-Memory-Daten.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUR serverseitig (Widget, Webhooks, Uploads, Cron). Niemals mit NEXT_PUBLIC_ prefixen, niemals im Client importieren.
SUPABASE_SERVICE_ROLE_KEY=

# ── KI (aktueller Provider: OpenAI; nur serverseitig) ────────
# Ohne AI_API_KEY (oder bei Fehlern): regelbasierter Mock-Extraktor.
AI_API_KEY=
# Leer lassen = gpt-4o-mini
AI_MODEL=gpt-4o-mini
# Leer lassen = OpenAI. Anderer OpenAI-kompatibler Endpunkt möglich.
AI_BASE_URL=https://api.openai.com/v1

# ── E-Mail-OAuth (ohne Werte: „Nicht verbunden“) ─────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── WhatsApp Business (ohne Werte: „Nicht verbunden“) ────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Empfang zusätzlich nur mit APP_SECRET (Signaturprüfung X-Hub-Signature-256) und COMPANY_ID (Büro, dem der Anschluss gehört).
WHATSAPP_APP_SECRET=
WHATSAPP_COMPANY_ID=

# ── Cron (Follow-ups, siehe vercel.json) ─────────────────────
# Vercel sendet das Secret automatisch als Bearer-Token. Zufallswert, z. B. `openssl rand -hex 32`.
# Ohne Wert antwortet /api/cron/follow-ups mit 503 (kein Absturz).
CRON_SECRET=

# ── Stripe (nur vorbereitet, im Code aktuell nur STRIPE_SECRET_KEY als „konfiguriert?“-Flag) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
