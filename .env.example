NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (ohne diese Werte startet die App im Demo-Modus mit In-Memory-Daten)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# KI (OpenAI-kompatible API, nur serverseitig). Ohne Key: regelbasierter Mock-Extraktor.
AI_API_KEY=
AI_MODEL=
# Optional: anderer OpenAI-kompatibler Endpunkt, Standard https://api.openai.com/v1
AI_BASE_URL=

# E-Mail-OAuth (ohne Werte: Mock-Modus, nichts wird als verbunden angezeigt)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# WhatsApp Business (noch nicht produktiv angebunden)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Stripe (nur vorbereitet)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
